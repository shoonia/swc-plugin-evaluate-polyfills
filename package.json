{
  "name": "swc-plugin-evaluate-polyfills",
  "version": "0.1.5",
  "type": "module",
  "description": "An SWC plugin that statically evaluates inline polyfill checks at build time.",
  "main": "index.wasm",
  "exports": {
    ".": "./index.wasm"
  },
  "files": [
    "index.wasm"
  ],
  "scripts": {
    "build": "sh build.sh",
    "test": "cargo test",
    "prepack": "npm test && npm run build",
    "fixture": "UPDATE=1 cargo test --test fixture",
    "lint": "cargo clippy -- -D warnings"
  },
  "peerDependencies": {
    "@swc/core": "^1.16.13"
  },
  "peerDependenciesMeta": {
    "@swc/core": {
      "optional": true
    }
  },
  "preferUnplugged": true,
  "author": {
    "name": "Alexander Zaytsev",
    "email": "zaytsev126@gmail.com",
    "url": "https://x.com/_shoonia"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shoonia/swc-plugin-evaluate-polyfills"
  },
  "license": "MIT",
  "keywords": [
    "swc-plugin",
    "optimization",
    "minifier",
    "minify",
    "minimize"
  ]
}
